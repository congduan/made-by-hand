{
  "name": "craftplay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "verify": "node verify/verify.mjs && node verify/verify-house.mjs && node verify/verify-magnets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "pinia": "^4.1.0",
    "three": "^0.186.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.13"
  }
}
